# Local Docker deployment: copy this file to .env and choose a strong password.
# Build humanwill-artex-en:local from this checkout first; see README.md.
# No prebuilt HumanWill image is published. Compose will not pull an upstream image.
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM credentials are optional here; they can also be configured in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
